{
  "name": "cryptopos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@cryptopos/web",
    "dev:api": "npm run start:dev --workspace=@cryptopos/api",
    "worker": "npm run worker --workspace=@cryptopos/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@cryptopos/api",
    "db:migrate": "npm run prisma:migrate --workspace=@cryptopos/api",
    "db:deploy": "npm run prisma:deploy --workspace=@cryptopos/api"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
