# Multi-stage production Dockerfile for CryptoPOS API Server

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies for native modules if needed
RUN apk add --no-cache python3 make g++

# Copy root workspace and package manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install all dependencies including devDependencies for build
RUN npm ci

# Copy API source and Prisma schema
COPY apps/api ./apps/api

# Generate Prisma Client
# Prisma's workspace script reads ../../.env. The image must not contain real
# deployment credentials, so provide a build-only placeholder for generation.
RUN printf 'DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public\n' > .env \
    && npm run db:generate \
    && rm .env

# Build API application
RUN npm run build --workspace=@cryptopos/api

# Stage 2: Production Runtime
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Install dumb-init for proper signal handling (SIGTERM, SIGINT)
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S cryptopos && \
    adduser -u 1001 -S cryptopos -G cryptopos

# Copy built application and production dependencies
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

USER cryptopos

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/health/live || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/api/dist/main.js"]
