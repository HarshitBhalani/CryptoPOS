{
  "name": "@cryptopos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "worker": "nest start --entryFile worker",
    "worker:dev": "nest start --entryFile worker --watch",
    "prisma:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.5.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bcryptjs": "^3.0.3",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
