# CryptoPOS Production Environment Template
# Copy this file to .env.production on your production host and populate with real secrets.
# NEVER commit .env.production to version control.

# Node Environment
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
POSTGRES_USER=cryptopos
POSTGRES_PASSWORD=PASTE_GENERATED_HEX_PASSWORD_HERE
POSTGRES_DB=cryptopos
# Paste the same generated password into this URL; do not leave the placeholder.
DATABASE_URL=postgresql://cryptopos:PASTE_THE_SAME_HEX_PASSWORD_HERE@postgres:5432/cryptopos?schema=public

# Redis Connection (used for throttler, distributed lock, and session cache)
REDIS_URL=redis://redis:6379

# Security Secrets (Generate using: openssl rand -base64 48)
# Must be at least 32 characters long
JWT_SECRET=replace_with_secure_random_base64_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_base64_string_min_32_chars

# Domain Endpoints & CORS Configuration
# Include your production HTTPS domains. Multiple origins can be comma-separated.
FRONTEND_URL=https://pos.yourdomain.com
BACKEND_URL=https://pos.yourdomain.com

# Public Client Environment Variables for Next.js; these are embedded at Docker build time.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Blockchain Configuration (Strictly Devnet)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_EXPLORER_URL=https://explorer.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PAYMENT_CONFIRMATION_LEVEL=finalized

# Optional Platform Fee Configuration
# Leave empty for 0% fee. If configured, must be a valid 32-byte Base58 Solana public key.
PLATFORM_FEE_WALLET=
PLATFORM_FEE_BPS=0

# Quote & Payment Timers
QUOTE_TTL_SECONDS=120
PAYMENT_LATE_GRACE_SECONDS=30

# Required for live quote creation. Get a free CoinGecko Demo API key.
PRICE_PROVIDER_API_KEY=
PRICE_CACHE_TTL_SECONDS=15
PRICE_MAX_AGE_SECONDS=120
